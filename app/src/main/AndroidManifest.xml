<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No INTERNET permission: City Memory is fully offline. External navigation is
      delegated to whatever maps app the user already has, via an implicit Intent.
    -->

    <!--
      Location is optional and asked for only when the user taps "use my
      location" while adding a place they are standing in. It does not weaken
      the offline claim above: a GPS fix comes from satellites and needs no
      network, which is exactly why the platform LocationManager is used here
      rather than Play services' fused provider.

      Both are declared because Android 12 and later let the user grant the
      approximate one instead; the app accepts either and lets them drag the
      ring the rest of the way.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Background location, for the dwell detector that offers to log a place
      you stayed at. Strictly optional: the feature is off until the user turns
      it on in Explore, and everything else in the app works without it.

      Android 10 (API 29) split this out from the foreground permissions, and
      from Android 11 (API 30) it cannot be requested in the same dialog as
      them — the system shows no dialog at all for it. The only thing that works
      is to hold the foreground grant first and then send the user to Settings,
      which is what `BackgroundLocationPermission` does and why the feature asks
      twice.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Android 13 (API 33) made posting a notification a runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Reads the GPS tag out of a photo the user picked.

      Not a storage permission: photos come from the system picker, which grants
      access to exactly the images chosen and needs nothing declared. But since
      Android 10 (API 29) MediaStore *redacts* location out of the bytes it
      hands over unless the app holds this and asks for the original — so
      without it every photo looks as though it were taken nowhere.
    -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- The app works without a GPS receiver; it just cannot offer the shortcut. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <queries>
        <!-- Lets us detect a geo:-capable app before falling back to a web URI. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CityMemoryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CityMemory">

        <!--
          configChanges: this is a Compose-only Activity, so it can absorb
          configuration changes itself rather than being torn down and rebuilt.
          That matters more here than in most apps — a rotation would otherwise
          re-inflate the whole tree and re-run the map's projection of ~387,000
          points, which is most of a second on a mid-range phone.
        -->
        <!--
          launchMode: the notification has to arrive at the Activity that is
          already running. Left at `standard`, tapping it while the app is open
          builds a second MainActivity with its own NavController, its own
          composition and its own copy of the map projection the configChanges
          note below exists to avoid — twice the memory and a visible relaunch,
          for a tap that meant "show me the thing I already have open".
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/Theme.CityMemory"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager's own initialiser is removed and the library is started on
          demand instead, from `AppContainer`.

          The default initialiser is a ContentProvider, which runs on every cold
          start of the process — including the many that have nothing to do with
          this feature — and it opens WorkManager's own database while doing it.
          This app goes out of its way to keep process creation cheap and not to
          touch a database until a screen asks for data; a provider that does
          both, for a feature most users will leave switched off, is the wrong
          trade. `Configuration.Provider` on the Application supplies the
          configuration when something first asks.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
