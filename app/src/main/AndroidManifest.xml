<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission: City Memory is fully offline. External navigation is
      delegated to whatever maps app the user already has, via an implicit Intent.
    -->

    <queries>
        <!-- Lets us detect a geo:-capable app before falling back to a web URI. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CityMemoryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CityMemory">

        <!--
          configChanges: this is a Compose-only Activity, so it can absorb
          configuration changes itself rather than being torn down and rebuilt.
          That matters more here than in most apps — a rotation would otherwise
          re-inflate the whole tree and re-run the map's projection of ~387,000
          points, which is most of a second on a mid-range phone.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode|layoutDirection|locale"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.CityMemory"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
