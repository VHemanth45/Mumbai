<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns all in-app styling. This theme only controls the pre-Compose
      window so launch never flashes white against the dark city.
    -->
    <style name="Theme.CityMemory" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/city_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
